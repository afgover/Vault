<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Bluetooth klavye (PC'ye yazma) özelliği için -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".VaultApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vault"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Otomatik doldurma kimlik doğrulaması: kilit açma ekranı.
             Son uygulamalar listesinde görünmez, kendi görevinde çalışır. -->
        <activity
            android:name=".autofill.AutofillUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=".autofill"
            android:windowSoftInputMode="adjustResize" />

        <!-- Klavyedeki "Kilidi aç" düğmesinin açtığı ekran. -->
        <activity
            android:name=".ime.ImeUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=".ime"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".autofill.VaultAutofillService"
            android:exported="true"
            android:label="@string/autofill_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <service
            android:name=".ime.VaultImeService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/ime_method" />
        </service>
    </application>
</manifest>
