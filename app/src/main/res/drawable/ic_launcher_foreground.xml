<?xml version="1.0" encoding="utf-8"?>
<!--
  Sekuvo simgesi: içi boş gövdeli asma kilit + </>.

  Boş gövde bilinçli. Kategorideki her rakip dolu bir kilit kullanıyor; içi
  görünen bir kilit hem raftan ayrışıyor hem de ürünün asıl iddiasını biçimin
  kendisiyle söylüyor — içeride saklanan bir şey yok, kod okunabilir.
  "Çevrimdışı" bilinçli olarak simgeye konmadı: denendi ve kulpu bozmadan
  anlatılamıyor; o kelimeyi mağaza başlığı ve slogan taşıyor.

  Ölçüler 108dp'lik uyarlanabilir simge kanvasında, güvenli bölge içinde.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:translateX="20.52"
        android:translateY="20.52">

        <!-- kulp: üst yarım halka, konturlu -->
        <path
            android:strokeColor="#C9A34C"
            android:strokeWidth="5.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M35.6,44.5 v-9.2 a18.4,18.4 0 0 1 36.8,0 v9.2" />

        <!-- gövde: içi boş -->
        <path
            android:strokeColor="#C9A34C"
            android:strokeWidth="5.5"
            android:fillColor="#00000000"
            android:pathData="M32.5,44.5 h43 a7.2,7.2 0 0 1 7.2,7.2 v29.6 a7.2,7.2 0 0 1 -7.2,7.2 h-43 a7.2,7.2 0 0 1 -7.2,-7.2 v-29.6 a7.2,7.2 0 0 1 7.2,-7.2 z" />

        <!-- &lt; -->
        <path
            android:strokeColor="#C9A34C"
            android:strokeWidth="4.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M45.5,58.5 l-6.5,8 6.5,8" />
        <!-- / -->
        <path
            android:strokeColor="#C9A34C"
            android:strokeWidth="3.6"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M56.3,56.2 l-4.6,20.6" />
        <!-- &gt; -->
        <path
            android:strokeColor="#C9A34C"
            android:strokeWidth="4.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M62.5,58.5 l6.5,8 -6.5,8" />
    </group>
</vector>
